# Copy this file to .env.local and fill in your key. .env.local is git-ignored.
# NEVER put a real key in this file, in chat, or in the repository.

# Your Anthropic API key (https://platform.claude.com/settings/keys).
# It is only ever read by server code (src/lib/anthropic.ts).
ANTHROPIC_API_KEY=

# Development only: save the raw Anthropic response of every research call to ./debug/
# (git-ignored; useful for inspecting what Claude returned). Set to false to turn off.
SAVE_DEBUG_RUNS=true

# Your PostgreSQL connection string (Supabase: Connect -> Connection string -> Transaction pooler).
# It contains your database password. SERVER ONLY (src/lib/repo/server.ts); never in the browser, chat or Git.
# Create the tables once by running db/migrations/001_init.sql in the Supabase SQL Editor.
DATABASE_URL=

# AI_MODE decides whether the research routes make real, PAID Anthropic calls.
#   mock - answer from a saved sample, never create an Anthropic client (free; the default for `npm run dev`)
#   live - call Anthropic (the default on Vercel deployments, i.e. production builds)
# Leave it unset to get those defaults. Vercel Preview deployments default to mock.
AI_MODE=

# Mock mode only: how many milliseconds each fake stage "works" (so progress screens can be seen). 0 = instant.
MOCK_DELAY_MS=700
